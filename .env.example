# Порт и каталог данных
PORT=3000
DATA_DIR=./data

# За обратным прокси с HTTPS (nginx, Caddy, Cloudflare): доверять X-Forwarded-* и ставить Secure на cookie
TRUST_PROXY=0
COOKIE_SECURE=0

# Лимиты
MAX_PHOTO_MB=40
MAX_IMPORT_MB=300
HISTORY_LIMIT=1000
REG_LIMIT_PER_HOUR=10

# Облачная копия (S3-совместимое хранилище). Если не заданы — облако выключено.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_REGION=ru-central1
S3_PREFIX=rod/
